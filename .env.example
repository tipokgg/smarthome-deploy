# Скопировать в .env. BACKEND_IMAGE и FRONTEND_IMAGE переписывает scripts/update.sh: в них digest того образа,
# что сейчас запущен. Ручной откат - вписать нужный тег (например, ghcr.io/tipokgg/smarthome-backend:sha-78e09c2),
# поставить AUTO_UPDATE=0 и выполнить `docker compose up -d`.
BACKEND_IMAGE=ghcr.io/tipokgg/smarthome-backend:main
FRONTEND_IMAGE=ghcr.io/tipokgg/smarthome-frontend:main

# откуда брать обновления
BACKEND_TRACK=ghcr.io/tipokgg/smarthome-backend:main
FRONTEND_TRACK=ghcr.io/tipokgg/smarthome-frontend:main

# 0 - таймер обновлений ничего не делает
AUTO_UPDATE=1

# уведомления об обновлениях и откатах; пусто - только в журнал (journalctl -u smarthome-update)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
